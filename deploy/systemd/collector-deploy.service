# Host-side collector rollout. Install to /etc/systemd/system/ and adjust
# User and the three paths. Exit 2 (revision refused) and 3/4 (CI or Pages
# still pending) are normal outcomes; 1 (rolled back) and 5 (Pages failed)
# leave the unit failed so `systemctl --failed` shows them.
[Unit]
Description=Deploy the dashboard collector after a green main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=paolino
Environment=PATH=/run/current-system/sw/bin
Environment=DEPLOY_STACK_DIR=/srv/prod-hot/services/moog-antithesis-dashboard
# The read token never appears in the command line or the environment: the
# unit exposes a private copy as a credential file.
LoadCredential=gh-read:/srv/moog-antithesis-dashboard/gh-read
Environment=DEPLOY_GH_TOKEN_FILE=%d/gh-read
ExecStart=/run/current-system/sw/bin/nix run --quiet github:lambdasistemi/moog-antithesis-dashboard#collector-deploy -- update
SuccessExitStatus=2 3 4
TimeoutStartSec=3h
